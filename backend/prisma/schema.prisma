generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model conversation {
  id String @id @default(uuid())
  createdAt DateTime @default(now())
  message Message[]
}

model Message {
  id String  @id @default(uuid())
  conversationId String 
  converasation Conversation @realtion(fields: [conversationId], references: [id])
  sender String
  text String
  createdAt DateTime @default(now())
}